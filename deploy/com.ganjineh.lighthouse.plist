<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly Lighthouse run from a Mac (Monday 09:00), where Chrome and Node already exist.
     Edit the paths (and the URL once a real domain exists), then:  cp deploy/com.ganjineh.lighthouse.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.ganjineh.lighthouse.plist
     Stop it with:  launchctl unload ~/Library/LaunchAgents/com.ganjineh.lighthouse.plist -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ganjineh.lighthouse</string>
  <key>WorkingDirectory</key><string>/Users/YOU/Desktop/Projects/Websites/V9</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string><string>tools/run_scheduled_check.sh</string><string>lighthouse</string>
    <string>/usr/local/bin/node</string><string>tools/lighthouse_weekly.mjs</string><string>https://amirronaldo319.github.io/ganjineh-ofogh</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
</dict></plist>
